# web-ext sign / build の生成物
web-ext-artifacts/
*.xpi
*.zip

# tools/fixture.html から CSS を埋め込んで生成する検証用ファイル
tools/*.built.html

node_modules/

# OS
Thumbs.db
desktop.ini
.DS_Store

# 秘密情報。AMO の API キーはリポジトリ外 (~/.web-ext-config.cjs) に置く方針だが、
# 取り違えて中に置いてしまった時の保険として弾いておく
.env
.env.*
*.pem
web-ext-config.local.*
.web-ext-config.*

# web-ext sign が作る状態ファイル。AMO 上のアドオンを特定する UUID が入る。
# 秘密ではないがローカル状態なので追跡しない (残っているとリリース前の
# 「作業ツリーが綺麗か」チェックに引っかかる)
.amo-upload-uuid
